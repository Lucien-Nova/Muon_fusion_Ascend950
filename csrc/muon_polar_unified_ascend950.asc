/*
 * Ascend 950 Polar standalone source.
 *
 * 最终链路：LF/LF2 Cube1 -> persistent Cube2+P -> low-level Cube3+Y。
 * 完整源码自包含；运行时由 binding 在同一 stream 上顺序 launch 三个 kernel。
 */

#include <cstdint>

#define MUON_ASCEND950_UNIFIED_TRANSLATION_UNIT 1
#define ASCENDC_CUBE_ONLY

#include "acl/acl.h"
#include "kernel_basic_intf.h"
#include "adv_api/matmul/matmul_intf.h"
#include "adv_api/transpose/confusion_transpose.h"

#if defined(__NPU_HOST__)
namespace AscendC {
constexpr uint32_t TOTAL_L0C_SIZE = 256U * 1024U;
constexpr uint32_t TOTAL_L1_SIZE = 512U * 1024U;
constexpr uint16_t SYNC_AIC_AIV_FLAG = 13;
}
#ifdef ASCENDC_ASSERT
#undef ASCENDC_ASSERT
#endif
#define ASCENDC_ASSERT(cond, behavior) ((void)0)
#endif

#ifndef X_LOG
#define X_LOG(format, ...)
#endif

#include "cmct/block/block_mmad_pingpong_without_que.h"

using namespace AscendC;

/* ============================== Cube1 ============================== */
/*
 * Ascend 950（3510）Cube1 low-level + UB mirror 融合 kernel。
 *
 * 数学目标（每个 batch）：
 *   Z = X @ X.T,  X:[rows, common], Z:[rows, rows]
 *
 * Z 是对称矩阵，因此只调度 tileM <= tileN 的上三角。数据流为：
 *   AIC: X(GM) -> BlockMmad -> upper(FP32, L0C)
 *        -> dual Fixpipe(NoQuant, SPLIT_M)
 *        -> AIV0/AIV1 的 UB，各得到一半 M 行
 *   AIV: FP32 -> BF16 -> ND2ND transpose
 *        -> Z upper/lower(BF16, GM)
 *
 * 基础 LF 路线一次计算一个 128x128 tile；LF2 路线把同一 tileM 上相邻
 * 两个 tileN 合成 128x256 group，使两次结果共享 A panel。dual Fixpipe
 * 再沿 M 把 group 平分给两个 AIV，每个 AIV 最多处理 64x256 元素。
 * 3510 不允许 dualDstCtl 与 F322BF16 同时启用，所以 L0C->UB 必须保持
 * FP32 NoQuant，BF16 舍入放在 AIV 中执行。
 *
 * 启动契约：KERNEL_TYPE_MIX_AIC_1_2；rows 必须为 128 的整数倍，
 * groupTiles 只能为 1 或 2。host tiling 已保证这些前提。
 */

// 固定的 M/N 基本 tile；LF2 最多把两个相邻 N tile 合并为一个 group。
constexpr uint32_t kGramFusedTile = 128;
constexpr uint32_t kGramFusedMaxGroupTiles = 2;
constexpr uint32_t kGramFusedMaxCols =
    kGramFusedTile * kGramFusedMaxGroupTiles;
// dual Fixpipe 沿 M=128 平分，每个 AIV 固定接收 64 行。
constexpr uint32_t kGramFusedHalfRows = 64;
constexpr uint32_t kGramFusedMaxHalfElements =
    kGramFusedHalfRows * kGramFusedMaxCols;
// BlockMmad 的 L1 K tile 与 L0 K tile；完整 common 维由内部循环累加。
constexpr uint32_t kGramFusedL1K = 256;
constexpr uint32_t kGramFusedL0K = 64;
// 3510 每个 AIV 有 248 KiB UB，ping/pong 分别从 0 和 124 KiB 起始。
constexpr uint32_t kGramFusedPongOffset = 124U * 1024U;
// 单个 UB 槽的三个区域：Fixpipe FP32 输入、BF16 upper、转置临时区。
constexpr uint32_t kGramFusedMaxFloatBytes =
    kGramFusedMaxHalfElements * sizeof(float);
constexpr uint32_t kGramFusedMaxBf16Bytes =
    kGramFusedMaxHalfElements * sizeof(bfloat16_t);
constexpr uint32_t kGramFusedTmpBytes = 20U * 1024U;
// lower tensor 在 Cast 完成后复用已经失效的 FP32 输入区，因此不额外计费。
constexpr uint32_t kGramFusedSlotBytes = kGramFusedMaxFloatBytes +
    kGramFusedMaxBf16Bytes + kGramFusedTmpBytes;
static_assert(kGramFusedSlotBytes <= kGramFusedPongOffset,
    "Cube1 fused ping slot exceeds one UB half");

// AIC/AIV 握手协议。每个 slot 有 free 与 ready 两类 token；AIV1 的
// 同类 flag 编号在 AIV0 基础上加 16。AIC 必须同时等待两个 AIV。
constexpr uint16_t kGramFusedCvMode = 4;            // 跨核同步模式
constexpr int16_t kGramFusedFreeFlag = 5;           // 5/6: ping/pong 可写
constexpr int16_t kGramFusedReadyFlag = 8;          // 8/9: ping/pong 可读
constexpr int16_t kGramFusedSecondAivFlagOffset = 16;

// 由 host 生成并拷入 GM。字段顺序也是 host/device ABI，不可单边调整。
struct MuonGramLowLevelFusedTilingData {
    uint32_t batch;              // batch 数 B
    uint32_t rows;               // X 的 M，也是 Z 的两个维度
    uint32_t common;             // X 的 K/common 维
    uint32_t dim;                // rows / 128，即单轴 tile 数
    uint32_t usedCoreNum;        // 实际启动并参与轮询的 mixed block 数
    uint32_t groupsPerBatch;     // 一个 batch 的上三角 N-group 总数
    uint32_t groupTiles;         // 每个 group 含 1（LF）或 2（LF2）个 N tile
    ConfusionTransposeTiling transposeTiling128; // 64x128 BF16 转置参数
    ConfusionTransposeTiling transposeTiling256; // 64x256 BF16 转置参数
};

// tiling 位于 GM，不能直接按普通对象赋值；按 32 bit word 拷入寄存器/栈上
// 的本地结构，供 Transpose API 在 AIV 上重复使用。
__aicore__ inline void CopyGramFusedTransposeTiling(
    ConfusionTransposeTiling &dst,
    const __gm__ ConfusionTransposeTiling *src)
{
    auto dstWords = reinterpret_cast<uint32_t *>(&dst);
    auto srcWords = reinterpret_cast<const __gm__ uint32_t *>(src);
    for (uint32_t i = 0;
         i < sizeof(ConfusionTransposeTiling) / sizeof(uint32_t); ++i) {
        dstWords[i] = srcWords[i];
    }
}

/*
 * 将线性 group 索引还原成上三角坐标。
 * 第 row 行含 dim-row 个 tile，再按 groupTiles 向上取整分组：
 *   row=0: (0,0..), row=1: (1,1..), ...
 * 返回 tileN 为 group 的首列，tileCols 为该 group 的实际 tile 数；最后一组
 * 在 LF2 下可能只有一个 tile。
 */
__aicore__ inline void GramFusedUpperGroupFromIndex(uint32_t index,
    uint32_t dim, uint32_t groupTiles, uint32_t &tileM, uint32_t &tileN,
    uint32_t &tileCols)
{
    uint32_t row = 0;
    uint32_t remaining = dim;
    uint32_t rowLen = (remaining + groupTiles - 1U) / groupTiles;
    while (index >= rowLen) {
        index -= rowLen;
        ++row;
        --remaining;
        rowLen = (remaining + groupTiles - 1U) / groupTiles;
    }
    tileM = row;
    tileN = row + index * groupTiles;
    const uint32_t colsLeft = dim - tileN;
    tileCols = colsLeft < groupTiles ? colsLeft : groupTiles;
}

class MuonGramLowLevelFusedAic {
public:
    // BlockMmad 固定以 M=128、最大 N=256 分块；实际 N 通过 blockShape
    // 传入。A 读取 X，B 以 transpose=true 解释同一 X，完成 X @ X.T。
    using L1TileShape = AscendC::Shape<Cmct::Gemm::_128,
        Cmct::Gemm::_256, Cmct::Gemm::_256>;
    using L0TileShape = AscendC::Shape<Cmct::Gemm::_128,
        Cmct::Gemm::_256, Cmct::Gemm::_64>;
    using DispatchPolicy = Cmct::Gemm::MatmulMultiBlockWithOutQue<
        AscendC::Shape<Cmct::Gemm::_0, Cmct::Gemm::_0,
            Cmct::Gemm::_0, Cmct::Gemm::_0>,
        Cmct::Gemm::NONE_FULL_LOAD_MODE>;
    using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        bfloat16_t, false>;
    using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        bfloat16_t, true>;
    using CType = matmul::MatmulType<TPosition::VECIN, CubeFormat::ND,
        float, false>;
    using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        float, false>;
    using BlockMmadOp = Cmct::Gemm::Block::BlockMmad<DispatchPolicy,
        L1TileShape, L0TileShape, AType, BType, CType, BiasType, void>;
    using TupleShape = AscendC::Shape<int64_t, int64_t, int64_t, int64_t>;
    using TupleL1L0Shape = AscendC::Shape<int64_t, int64_t, int64_t,
        int64_t, int64_t, int64_t>;

    // 建立 GM 视图并初始化常驻 BlockMmad。z 只被借作未启用 bias 的占位
    // 地址；Z 的实际写回完全由 AIV 完成。
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z,
        const __gm__ MuonGramLowLevelFusedTilingData *tilingData)
    {
        batch_ = tilingData->batch;
        rows_ = tilingData->rows;
        common_ = tilingData->common;
        dim_ = tilingData->dim;
        usedCoreNum_ = tilingData->usedCoreNum;
        groupsPerBatch_ = tilingData->groupsPerBatch;
        groupTiles_ = tilingData->groupTiles;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x),
            static_cast<uint64_t>(batch_) * rows_ * common_);
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(z), 1);

        // problemShape 描述完整 Gram；tileL1/tileL0 描述当前低层实现允许
        // 的最大块。nonContinuous 指示 B 侧按转置/非连续方式取数。
        TupleShape problemShape{static_cast<int64_t>(rows_),
            static_cast<int64_t>(rows_), static_cast<int64_t>(common_), 1};
        TupleShape tileL1{kGramFusedTile, kGramFusedMaxCols,
            kGramFusedL1K, 1};
        TupleShape tileL0{kGramFusedTile, kGramFusedMaxCols,
            kGramFusedL0K, 1};
        AscendC::Shape<int64_t, int64_t, int64_t> nonContinuous{0, 1, 1};
        mm_.template Init<Cmct::Gemm::NONE_FULL_LOAD_MODE>(problemShape,
            tileL1, tileL0, false, 2, true, nonContinuous);
        // 允许 copy-out 沿 M 把同一 L0C 分发给两个 AIV 子块。
        mm_.SetDualParam(true);
    }

    /*
     * mixed block 以 grid-stride 循环处理多个 group。sequence 而不是
     * workIdx 决定 ping/pong，保证同一常驻 block 本地严格交替复用 UB。
     * 协议为：wait free -> Cube/Fixpipe -> set ready。
     */
    __aicore__ inline void Process()
    {
        const uint32_t coreIdx = GetBlockIdx();
        const uint32_t totalWork = batch_ * groupsPerBatch_;
        uint32_t sequence = 0;
        for (uint32_t workIdx = coreIdx; workIdx < totalWork;
             workIdx += usedCoreNum_, ++sequence) {
            const uint32_t slot = sequence & 1U;
            const int16_t freeFlag = kGramFusedFreeFlag +
                static_cast<int16_t>(slot);
            CrossCoreWaitFlag<kGramFusedCvMode, PIPE_FIX>(freeFlag);
            CrossCoreWaitFlag<kGramFusedCvMode, PIPE_FIX>(
                freeFlag + kGramFusedSecondAivFlagOffset);

            // 将全局工作项拆成 batch 与该 batch 内的上三角 group。
            const uint32_t batchIdx = workIdx / groupsPerBatch_;
            const uint32_t groupIdx = workIdx - batchIdx * groupsPerBatch_;
            uint32_t tileM = 0;
            uint32_t tileN = 0;
            uint32_t tileCols = 0;
            GramFusedUpperGroupFromIndex(groupIdx, dim_, groupTiles_,
                tileM, tileN, tileCols);
            ProcessTile(batchIdx, tileM, tileN, tileCols, slot,
                sequence == 0U);

            const int16_t readyFlag = kGramFusedReadyFlag +
                static_cast<int16_t>(slot);
            CrossCoreSetFlag<kGramFusedCvMode, PIPE_FIX>(readyFlag);
            CrossCoreSetFlag<kGramFusedCvMode, PIPE_FIX>(
                readyFlag + kGramFusedSecondAivFlagOffset);
        }

        // kernel 退出前回收两个槽，确保最后一代 AIV 转置/GM 写回已经结束。
        if (sequence != 0U) {
            WaitForAiv();
        }
    }

private:
    __aicore__ inline void ProcessTile(uint32_t batchIdx, uint32_t tileM,
        uint32_t tileN, uint32_t tileCols, uint32_t slot, bool firstTile)
    {
        // A panel 从 tileM 行开始；B panel 从 tileN 行开始并由 BType 的
        // transpose=true 解释，因此计算 X[mBase,:] @ X[nBase,:].T。
        const uint32_t mBase = tileM * kGramFusedTile;
        const uint32_t nBase = tileN * kGramFusedTile;
        const uint64_t xBatchOffset =
            static_cast<uint64_t>(batchIdx) * rows_ * common_;
        const uint64_t aOffset = xBatchOffset +
            static_cast<uint64_t>(mBase) * common_;
        const uint64_t bOffset = xBatchOffset +
            static_cast<uint64_t>(nBase) * common_;
        // BlockMmad 的 VECIN 目的张量实际由 dual Fixpipe 映射到两个 AIV
        // 的相同 UB 偏移，各自只看到 M 方向的一半结果。
        const uint32_t ubOffset = slot == 0U ? 0U : kGramFusedPongOffset;
        LocalTensor<float> upperUb(TPosition::VECIN, ubOffset,
            kGramFusedMaxHalfElements);
        const uint32_t curCols = tileCols * kGramFusedTile;
        // LF2 尾组可能退化为 128 列；其余计算和缓冲仍使用最大容量。
        TupleL1L0Shape blockShape{kGramFusedTile,
            static_cast<int64_t>(curCols),
            static_cast<int64_t>(common_), 1, kGramFusedTile,
            static_cast<int64_t>(curCols)};

        // firstTile 只在该 block 的第一代为 true，用于初始化 BlockMmad
        // 内部 ping-pong 状态；结果不会写 GM，而是落到 upperUb。
        mm_.template operator()<LocalTensor<float>, CubeFormat::ND>(
            upperUb, xGm_[aOffset], xGm_[bOffset], biasGm_, blockShape,
            0, 0, firstTile);
    }

    __aicore__ inline void WaitForAiv()
    {
        // free flag 会被 wait 消耗；这里分别回收 ping/pong × AIV0/AIV1。
        CrossCoreWaitFlag<kGramFusedCvMode, PIPE_FIX>(kGramFusedFreeFlag);
        CrossCoreWaitFlag<kGramFusedCvMode, PIPE_FIX>(
            kGramFusedFreeFlag + kGramFusedSecondAivFlagOffset);
        CrossCoreWaitFlag<kGramFusedCvMode, PIPE_FIX>(kGramFusedFreeFlag + 1);
        CrossCoreWaitFlag<kGramFusedCvMode, PIPE_FIX>(
            kGramFusedFreeFlag + 1 + kGramFusedSecondAivFlagOffset);
    }

    BlockMmadOp mm_;                    // 常驻低层矩阵乘法对象
    GlobalTensor<bfloat16_t> xGm_;      // X:[batch, rows, common]
    GlobalTensor<float> biasGm_;        // 未启用 bias，仅作接口占位
    uint32_t batch_;
    uint32_t rows_;
    uint32_t common_;
    uint32_t dim_;                      // 每轴 tile 数
    uint32_t usedCoreNum_;              // grid-stride 步长
    uint32_t groupsPerBatch_;
    uint32_t groupTiles_;
};

/*
 * AIV 侧后处理。两个 AIV 子块执行同一代码，但 GetSubBlockIdx() 分别为
 * 0/1，对应 tile 的前/后 64 行。每个子块只操作自己的独立 UB 地址空间，
 * 所以两者可以使用相同的 LocalTensor 偏移而不会互相覆盖。
 */
class MuonGramLowLevelFusedAiv {
public:
    // AIV 不再读取 X，只需 Z 的 GM 视图、任务划分信息和两套转置 tiling。
    __aicore__ inline void Init(GM_ADDR z,
        const __gm__ MuonGramLowLevelFusedTilingData *tilingData)
    {
        batch_ = tilingData->batch;
        rows_ = tilingData->rows;
        dim_ = tilingData->dim;
        usedCoreNum_ = tilingData->usedCoreNum;
        groupsPerBatch_ = tilingData->groupsPerBatch;
        groupTiles_ = tilingData->groupTiles;
        CopyGramFusedTransposeTiling(transposeTiling128_,
            &tilingData->transposeTiling128);
        CopyGramFusedTransposeTiling(transposeTiling256_,
            &tilingData->transposeTiling256);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(z),
            static_cast<uint64_t>(batch_) * rows_ * rows_);
    }

    /*
     * AIV 使用与配对 AIC 相同的 grid-stride 顺序，sequence 因而能在两侧
     * 一致地选中 ping/pong。启动时先发布两个 free token；每代执行
     * wait ready -> Cast/transpose/writeback -> set free。
     */
    __aicore__ inline void Process()
    {
        // mixed 1AIC:2AIV 下物理 task 索引需除以 task ratio，才能还原
        // 与 AIC GetBlockIdx() 相同的逻辑 mixed-block 编号。
        const uint32_t coreIdx = GetBlockIdx() / GetTaskRation();
        const uint32_t totalWork = batch_ * groupsPerBatch_;
        if (coreIdx >= totalWork) {
            return;
        }

        // 两个槽初始均为空。free 从 PIPE_MTE3 发布，保证其语义覆盖该
        // AIV 对 UB 的最后一次 GM 写回。
        CrossCoreSetFlag<kGramFusedCvMode, PIPE_MTE3>(kGramFusedFreeFlag);
        CrossCoreSetFlag<kGramFusedCvMode, PIPE_MTE3>(kGramFusedFreeFlag + 1);

        uint32_t sequence = 0;
        for (uint32_t workIdx = coreIdx; workIdx < totalWork;
             workIdx += usedCoreNum_, ++sequence) {
            const uint32_t slot = sequence & 1U;
            const int16_t readyFlag = kGramFusedReadyFlag +
                static_cast<int16_t>(slot);
            // ready 由 AIC 的 PIPE_FIX 发布；AIV 在 PIPE_V 上消费后才可
            // 读取 Fixpipe 写入当前槽的 FP32 数据。
            CrossCoreWaitFlag<kGramFusedCvMode, PIPE_V>(readyFlag);

            const uint32_t batchIdx = workIdx / groupsPerBatch_;
            const uint32_t groupIdx = workIdx - batchIdx * groupsPerBatch_;
            uint32_t tileM = 0;
            uint32_t tileN = 0;
            uint32_t tileCols = 0;
            GramFusedUpperGroupFromIndex(groupIdx, dim_, groupTiles_,
                tileM, tileN, tileCols);
            ProcessTile(batchIdx, tileM, tileN, tileCols, slot);

            // ProcessTile 已用 MTE3_S 闭合本地写回，随后归还当前槽。
            CrossCoreSetFlag<kGramFusedCvMode, PIPE_MTE3>(
                kGramFusedFreeFlag + static_cast<int16_t>(slot));
        }
    }

private:
    __aicore__ inline void ProcessTile(uint32_t batchIdx, uint32_t tileM,
        uint32_t tileN, uint32_t tileCols, uint32_t slot)
    {
        // subBlock=0/1 分别负责 128 行 tile 的上/下 64 行。
        const uint32_t subBlock = GetSubBlockIdx();
        const uint32_t rowBase = tileM * kGramFusedTile +
            subBlock * kGramFusedHalfRows;
        const uint32_t colBase = tileN * kGramFusedTile;
        const uint32_t curCols = tileCols * kGramFusedTile;
        const uint32_t halfElements = kGramFusedHalfRows * curCols;
        const uint32_t slotBase = slot == 0U ? 0U : kGramFusedPongOffset;

        // 当前槽的生命周期布局（最大 64x256）：
        //   [slotBase, +64 KiB)   FP32 upper（Fixpipe 写入）
        //   [+64 KiB, +96 KiB)   BF16 upper（Cast 输出）
        //   [+96 KiB, +116 KiB)  Transpose 临时区
        // Cast 完成后首段 FP32 已失效，可把同一地址重解释为 BF16 lower。
        LocalTensor<float> upperFloatUb(TPosition::VECIN, slotBase,
            kGramFusedMaxHalfElements);
        LocalTensor<bfloat16_t> upperUb(TPosition::VECOUT,
            slotBase + kGramFusedMaxFloatBytes,
            kGramFusedMaxHalfElements);
        // Cast 后 upperFloatUb 不再使用，lower 直接复用这段 UB。
        LocalTensor<bfloat16_t> lowerUb(TPosition::VECOUT,
            slotBase, kGramFusedMaxHalfElements);
        LocalTensor<uint8_t> tmpUb(TPosition::VECIN,
            slotBase + kGramFusedMaxFloatBytes + kGramFusedMaxBf16Bytes,
            kGramFusedTmpBytes);

        // 在 AIV 中执行 RN-even FP32->BF16，绕开 dual Fixpipe 与硬件量化
        // 不能组合的限制。
        Cast(upperUb, upperFloatUb, RoundMode::CAST_RINT,
            static_cast<int32_t>(halfElements));
        PipeBarrier<PIPE_V>();

        // 对角 group 的第一个 128x128 tile 转置后仍落在对角块内：其
        // lower 已由另一个 AIV/当前 upper 写覆盖，无需重复镜像。LF2 对角
        // group 的第二个 tile 是严格上三角，仍需转置，所以只跳过 128 行。
        const uint32_t lowerSkipRows = tileM == tileN
            ? kGramFusedTile : 0U;
        const uint32_t lowerRows = curCols - lowerSkipRows;
        if (lowerRows != 0U) {
            // host 分别为 64x128 与 64x256 生成 tiling；Transpose 输出形状
            // 为 [curCols,64]，正好对应镜像后的连续 lower 行。
            if (curCols == kGramFusedMaxCols) {
                Transpose(lowerUb.template ReinterpretCast<uint16_t>(),
                    upperUb.template ReinterpretCast<uint16_t>(), tmpUb,
                    TransposeType::TRANSPOSE_ND2ND_ONLY,
                    transposeTiling256_);
            } else {
                Transpose(lowerUb.template ReinterpretCast<uint16_t>(),
                    upperUb.template ReinterpretCast<uint16_t>(), tmpUb,
                    TransposeType::TRANSPOSE_ND2ND_ONLY,
                    transposeTiling128_);
            }
            PipeBarrier<PIPE_V>();
        }
        // 等待 Cast/Transpose 的向量写完成后，MTE3 才能读取 upper/lower。
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);

        // upper 以 [64,curCols] 分行写入 Z[rowBase:, colBase:]；GM 行距
        // 是 rows，UB 中各行紧密排列。
        const uint64_t upperOffset =
            static_cast<uint64_t>(batchIdx) * rows_ * rows_ +
            static_cast<uint64_t>(rowBase) * rows_ + colBase;
        DataCopyParams copyUpper;
        copyUpper.blockCount = kGramFusedHalfRows;
        copyUpper.blockLen =
            curCols * sizeof(bfloat16_t) / ONE_BLK_SIZE;
        copyUpper.srcStride = 0;
        copyUpper.dstStride =
            (rows_ - curCols) * sizeof(bfloat16_t) / ONE_BLK_SIZE;
        DataCopy(zGm_[upperOffset], upperUb, copyUpper);

        if (lowerRows != 0U) {
            // lower 的目标为 Z[colBase+skip:, rowBase:]，形状
            // [lowerRows,64]。源偏移跳过对角 group 中不需镜像的前 128 行。
            const uint64_t lowerOffset =
                static_cast<uint64_t>(batchIdx) * rows_ * rows_ +
                static_cast<uint64_t>(colBase + lowerSkipRows) * rows_ +
                rowBase;
            DataCopyParams copyLower;
            copyLower.blockCount = lowerRows;
            copyLower.blockLen =
                kGramFusedHalfRows * sizeof(bfloat16_t) / ONE_BLK_SIZE;
            copyLower.srcStride = 0;
            copyLower.dstStride =
                (rows_ - kGramFusedHalfRows) * sizeof(bfloat16_t) /
                ONE_BLK_SIZE;
            DataCopy(zGm_[lowerOffset],
                lowerUb[lowerSkipRows * kGramFusedHalfRows], copyLower);
        }

        // 将 upper/lower 两次异步 GM 写回都闭合到标量流水，之后才可向
        // AIC 发布 free，避免隔代复用同一 UB slot 时覆盖尚未消费的数据。
        SetFlag<HardEvent::MTE3_S>(2);
        WaitFlag<HardEvent::MTE3_S>(2);
    }

    GlobalTensor<bfloat16_t> zGm_;       // 对称输出 Z:[batch,rows,rows]
    ConfusionTransposeTiling transposeTiling128_; // LF/尾组 64x128
    ConfusionTransposeTiling transposeTiling256_; // LF2 满组 64x256
    uint32_t batch_;
    uint32_t rows_;
    uint32_t dim_;
    uint32_t usedCoreNum_;
    uint32_t groupsPerBatch_;
    uint32_t groupTiles_;
};

/*
 * 设备入口。一个逻辑 block 由 1 个 AIC 与 2 个 AIV 构成；两侧必须使用
 * 完全相同的 workIdx/sequence 顺序，否则 ping-pong flag 会串代。
 */
extern "C" __global__ __aicore__ void MuonGramLowLevelFused(
    GM_ADDR x, GM_ADDR z, GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    auto tilingData =
        reinterpret_cast<__gm__ MuonGramLowLevelFusedTilingData *>(tiling);
    // ASCEND_IS_AIC/AIV 在 mixed 编译中选择各自分支，不是运行时普通 if。
    if ASCEND_IS_AIC {
        MuonGramLowLevelFusedAic op;
        op.Init(x, z, tilingData);
        op.Process();
    }
    if ASCEND_IS_AIV {
        MuonGramLowLevelFusedAiv op;
        op.Init(z, tilingData);
        op.Process();
    }
}

// CPU 侧 C ABI 包装：blockDim 已由 host 限制为 min(coreDim,totalWork)，
// stream 保证与前后 PyTorch/NPU 操作保持同一异步执行序。
extern "C" void launch_muon_gram_lowlevel_fused(void *x, void *z,
    void *tiling, uint32_t blockDim, aclrtStream stream)
{
    MuonGramLowLevelFused<<<blockDim, nullptr, stream>>>(
        (GM_ADDR)x, (GM_ADDR)z, (GM_ADDR)tiling);
}


/* ============================== Cube2 + P ============================== */
/*
 * Ascend 950（3510）Cube2 + P epilogue 融合 kernel。
 *
 * 数学表达式（每个 batch）：
 *   A2 = A @ A.T
 *   P  = b * A + c * A2
 *
 * AIC 只计算 A2 的上三角 tile，并通过 dual Fixpipe 把 FP32 L0C 按 M
 * 拆给两个 AIV。AIV 在 UB 中读取对应的 A tile、完成线性组合和 BF16
 * 转换，再把 P 的 upper 与转置后的 lower 一次写回 GM。中间 A2 不落 GM。
 * 因为输入 A 对称，A @ A.T 与 A @ A 等价，输出 P 也保持对称。
 *
 * 数据流：
 *   AIC: A(GM) x A.T(GM) -> A2(FP32,L0C)
 *        -> dual Fixpipe(NoQuant,SPLIT_M) -> AIV0/AIV1 UB
 *   AIV: A(GM)->UB, b*A+c*A2(FP32)->BF16
 *        -> upper + ND2ND(lower) -> P(GM)
 *
 * 启动契约：KERNEL_TYPE_MIX_AIC_1_2、固定 128x128 Cube tile，rows 为
 * 128 的整数倍。常驻 block 固定 B panel，并用 ping/pong UB 连续处理 tile。
 */

// L0C 按 row-major 搬入 UB；dualDstCtl 随后沿 M 将结果一分为二。
constexpr uint32_t kCube2PTileM = 128;
constexpr uint32_t kCube2PTileN = 128;
constexpr uint32_t kCube2PHalfM = kCube2PTileM / 2U;
constexpr uint32_t kCube2PHalfElements = kCube2PHalfM * kCube2PTileN;

// 单个 AIV 的 UB 布局。两个 AIV 拥有独立 UB，均可使用相同偏移。
// 当前每个 block 只处理一块，全部控制在前 124 KiB，保留后半区供未来
// ping/pong 扩展。pInUb/pOutUb 是同一物理区在不同向量位置上的别名。
constexpr uint32_t kCube2PA2Offset = 0;
constexpr uint32_t kCube2PA2Bytes = kCube2PHalfElements * sizeof(float);
constexpr uint32_t kCube2PABf16Offset = kCube2PA2Offset + kCube2PA2Bytes;
constexpr uint32_t kCube2PABf16Bytes = kCube2PHalfElements * sizeof(bfloat16_t);
constexpr uint32_t kCube2PAFloatOffset = kCube2PABf16Offset + kCube2PABf16Bytes;
constexpr uint32_t kCube2PAFloatBytes = kCube2PHalfElements * sizeof(float);
constexpr uint32_t kCube2PPBf16Offset = kCube2PAFloatOffset + kCube2PAFloatBytes;
constexpr uint32_t kCube2PPBf16Bytes = kCube2PHalfElements * sizeof(bfloat16_t);
constexpr uint32_t kCube2PTransposeOffset = kCube2PPBf16Offset + kCube2PPBf16Bytes;
constexpr uint32_t kCube2PTransposeBytes = kCube2PHalfElements * sizeof(bfloat16_t);
// 转置 API 的临时空间从所有常驻张量之后开始；host 为 64x128 生成 tiling。
constexpr uint32_t kCube2PTmpInOffset = kCube2PTransposeOffset + kCube2PTransposeBytes;
constexpr uint32_t kCube2PSlotBytes = kCube2PTmpInOffset + 8U * 1024U;
constexpr uint32_t kCube2PPongOffset = 124U * 1024U;
static_assert(kCube2PSlotBytes <= kCube2PPongOffset,
    "Cube2+P ping slot exceeds one UB half");

// 单槽 AIC/AIV 握手：AIV 先发 free(5)，AIC Fixpipe 完成后发 ready(8)，
// AIV 写回 GM 后再次发 free。AIV1 使用同类编号 +16。
constexpr uint16_t kCube2PCvMode = 4;
constexpr int16_t kCube2PAivFreeFlag = 5;
constexpr int16_t kCube2PAicReadyFlag = 8;
constexpr int16_t kCube2PSecondAivFlagOffset = 16;

// host/device 共享的原始 ABI；字段顺序不可只在本文件中修改。
struct MuonCube2PTilingData {
    uint32_t batch;          // batch 数
    uint32_t rows;           // A/P 方阵边长
    uint32_t mDim;           // M 方向 128x128 tile 数
    uint32_t nDim;           // N 方向 tile 数；当前方阵要求 mDim==nDim
    uint32_t usedCoreNum;    // 启动的常驻 mixed block 数
    uint32_t bBits;          // FP32 系数 b 的原始 IEEE-754 bit pattern
    uint32_t cBits;          // FP32 系数 c 的原始 IEEE-754 bit pattern
    uint32_t reserved;       // 高 8 bit=panelM
    TCubeTiling cubeTiling;  // tile 尺寸和 host tiling
    ConfusionTransposeTiling transposeTiling; // 64x128 BF16 ND2ND tiling
};

// 设备侧小工具，避免依赖标准库实现。
__aicore__ inline uint32_t Cube2PMin(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline void CopyCube2PTransposeTiling(
    ConfusionTransposeTiling &dst,
    const __gm__ ConfusionTransposeTiling *src)
{
    auto dstWords = reinterpret_cast<uint32_t *>(&dst);
    auto srcWords = reinterpret_cast<const __gm__ uint32_t *>(src);
    for (uint32_t i = 0;
         i < sizeof(ConfusionTransposeTiling) / sizeof(uint32_t); ++i) {
        dstWords[i] = srcWords[i];
    }
}

/* persistent B-full 按列枚举：(tileN,mGroup)，组内连续处理多个 tileM。 */
__aicore__ inline uint32_t Cube2PColumnJobsPerBatch(uint32_t nDim,
    uint32_t panelM)
{
    uint32_t jobs = 0;
    for (uint32_t tileN = 0; tileN < nDim; ++tileN) {
        jobs += (tileN + 1U + panelM - 1U) / panelM;
    }
    return jobs;
}

__aicore__ inline void Cube2PColumnGroupFromIndex(uint32_t index,
    uint32_t nDim, uint32_t panelM, uint32_t &tileN, uint32_t &mGroup)
{
    tileN = 0;
    uint32_t groups = (tileN + 1U + panelM - 1U) / panelM;
    while (tileN + 1U < nDim && index >= groups) {
        index -= groups;
        ++tileN;
        groups = (tileN + 1U + panelM - 1U) / panelM;
    }
    mGroup = index;
}

/*
 * 低层常驻 Cube2：固定 tileN，把完整 B=A[tileN,:] panel 预载到 BL1，
 * 再连续计算多个 tileM。每个常驻 block 的相邻输出使用两份 L0C/UB 槽。
 */
class MuonCube2PLowLevelAicKernel {
public:
    using L1TileShape = AscendC::Shape<Cmct::Gemm::_128,
        Cmct::Gemm::_128, Cmct::Gemm::_256>;
    using L0TileShape = AscendC::Shape<Cmct::Gemm::_128,
        Cmct::Gemm::_128, Cmct::Gemm::_64>;
    using DispatchPolicy = Cmct::Gemm::MatmulMultiBlockWithOutQue<
        AscendC::Shape<Cmct::Gemm::_0, Cmct::Gemm::_0,
            Cmct::Gemm::_0, Cmct::Gemm::_0>,
        Cmct::Gemm::B_FULL_LOAD_MODE>;
    using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        bfloat16_t, false>;
    using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        bfloat16_t, true>;
    using CType = matmul::MatmulType<TPosition::VECIN, CubeFormat::ND,
        float, false>;
    using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        float, false>;
    using BlockMmadOp = Cmct::Gemm::Block::BlockMmad<DispatchPolicy,
        L1TileShape, L0TileShape, AType, BType, CType, BiasType, void>;
    using TupleShape = AscendC::Shape<int64_t, int64_t, int64_t, int64_t>;
    using TupleL1L0Shape = AscendC::Shape<int64_t, int64_t, int64_t,
        int64_t, int64_t, int64_t>;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR p,
        const __gm__ MuonCube2PTilingData *tilingData)
    {
        batch_ = tilingData->batch;
        rows_ = tilingData->rows;
        mDim_ = tilingData->mDim;
        nDim_ = tilingData->nDim;
        usedCoreNum_ = tilingData->usedCoreNum;
        panelM_ = tilingData->reserved >> 8U;
        if (panelM_ == 0U) {
            panelM_ = 1U;
        }

        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(a),
            static_cast<uint64_t>(batch_) * rows_ * rows_);
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(p), 1);

        TupleShape problemShape{static_cast<int64_t>(rows_),
            static_cast<int64_t>(rows_), static_cast<int64_t>(rows_), 1};
        TupleShape tileL1{kCube2PTileM, kCube2PTileN, 256, 1};
        TupleShape tileL0{kCube2PTileM, kCube2PTileN, 64, 1};
        AscendC::Shape<int64_t, int64_t, int64_t> nonContinuous{0, 1, 1};
        mm_.template Init<Cmct::Gemm::B_FULL_LOAD_MODE>(problemShape,
            tileL1, tileL0, false, 2, true, nonContinuous);
        mm_.SetDualParam(true);
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreIdx = GetBlockIdx();
        const uint32_t jobsPerBatch = Cube2PColumnJobsPerBatch(nDim_, panelM_);
        const uint32_t totalJobs = batch_ * jobsPerBatch;
        uint32_t sequence = 0;
        for (uint32_t jobIdx = coreIdx; jobIdx < totalJobs;
             jobIdx += usedCoreNum_) {
            const uint32_t batchIdx = jobIdx / jobsPerBatch;
            const uint32_t localJob = jobIdx - batchIdx * jobsPerBatch;
            uint32_t tileN = 0;
            uint32_t mGroup = 0;
            Cube2PColumnGroupFromIndex(localJob, nDim_, panelM_, tileN,
                mGroup);
            PrepareBPanel(batchIdx, tileN, sequence != 0U);
            for (uint32_t localM = 0; localM < panelM_; ++localM) {
                const uint32_t tileM = mGroup * panelM_ + localM;
                if (tileM > tileN) {
                    break;
                }
                ProcessTile(batchIdx, tileM, tileN, sequence++);
            }
        }

        if (sequence != 0U) {
            WaitForAiv();
        }
    }

private:
    __aicore__ inline void PrepareBPanel(uint32_t batchIdx, uint32_t tileN,
        bool hasPreviousPanel)
    {
        if (hasPreviousPanel) {
            SetFlag<HardEvent::MTE1_MTE2>(4);
            WaitFlag<HardEvent::MTE1_MTE2>(4);
        }
        const uint32_t nBase = tileN * kCube2PTileN;
        const uint32_t curN = Cube2PMin(kCube2PTileN, rows_ - nBase);
        const uint64_t bOffset = static_cast<uint64_t>(batchIdx) * rows_ * rows_ +
            static_cast<uint64_t>(nBase) * rows_;
        mm_.template CopyInB1<CubeFormat::ND>(aGm_[bOffset], curN, rows_);
        SetFlag<HardEvent::MTE2_MTE1>(4);
        WaitFlag<HardEvent::MTE2_MTE1>(4);
    }

    __aicore__ inline void ProcessTile(uint32_t batchIdx, uint32_t tileM,
        uint32_t tileN, uint32_t sequence)
    {
        const uint32_t slot = sequence & 1U;
        const int16_t freeFlag = kCube2PAivFreeFlag +
            static_cast<int16_t>(slot);
        const int16_t readyFlag = kCube2PAicReadyFlag +
            static_cast<int16_t>(slot);
        CrossCoreWaitFlag<kCube2PCvMode, PIPE_FIX>(freeFlag);
        CrossCoreWaitFlag<kCube2PCvMode, PIPE_FIX>(
            freeFlag + kCube2PSecondAivFlagOffset);

        const uint32_t mBase = tileM * kCube2PTileM;
        const uint32_t nBase = tileN * kCube2PTileN;
        const uint32_t curM = Cube2PMin(kCube2PTileM, rows_ - mBase);
        const uint32_t curN = Cube2PMin(kCube2PTileN, rows_ - nBase);
        const uint64_t batchOffset = static_cast<uint64_t>(batchIdx) * rows_ * rows_;
        const uint64_t aOffset = batchOffset + static_cast<uint64_t>(mBase) * rows_;
        const uint64_t bOffset = batchOffset + static_cast<uint64_t>(nBase) * rows_;
        const uint32_t slotBase = slot == 0U ? 0U : kCube2PPongOffset;
        LocalTensor<float> a2Ub(TPosition::VECIN, slotBase,
            kCube2PHalfElements);
        TupleL1L0Shape blockShape{static_cast<int64_t>(curM),
            static_cast<int64_t>(curN), static_cast<int64_t>(rows_), 1,
            static_cast<int64_t>(curM), static_cast<int64_t>(curN)};

        mm_.template operator()<LocalTensor<float>, CubeFormat::ND>(a2Ub,
            aGm_[aOffset], aGm_[bOffset], biasGm_, blockShape, 0, 0, false);
        CrossCoreSetFlag<kCube2PCvMode, PIPE_FIX>(readyFlag);
        CrossCoreSetFlag<kCube2PCvMode, PIPE_FIX>(
            readyFlag + kCube2PSecondAivFlagOffset);
    }

    __aicore__ inline void WaitForAiv()
    {
        CrossCoreWaitFlag<kCube2PCvMode, PIPE_FIX>(kCube2PAivFreeFlag);
        CrossCoreWaitFlag<kCube2PCvMode, PIPE_FIX>(
            kCube2PAivFreeFlag + kCube2PSecondAivFlagOffset);
        CrossCoreWaitFlag<kCube2PCvMode, PIPE_FIX>(kCube2PAivFreeFlag + 1);
        CrossCoreWaitFlag<kCube2PCvMode, PIPE_FIX>(
            kCube2PAivFreeFlag + 1 + kCube2PSecondAivFlagOffset);
    }

    BlockMmadOp mm_;
    GlobalTensor<bfloat16_t> aGm_;
    GlobalTensor<float> biasGm_;
    uint32_t batch_;
    uint32_t rows_;
    uint32_t mDim_;
    uint32_t nDim_;
    uint32_t usedCoreNum_;
    uint32_t panelM_;
};

/*
 * AIV 侧 epilogue。AIV0/AIV1 分别处理当前 tile 的前/后半行，独立完成
 * A 搬入、线性组合、BF16 Cast、镜像转置和 GM 写回。
 */
class MuonCube2PAivKernel {
public:
    // 将 FP32 系数保留为原始 bits，避免 host/device ABI 中的浮点转换，
    // 并把 GM tiling 显式拷入 AIV 可直接访问的本地结构。
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR p,
        const __gm__ MuonCube2PTilingData *tilingData)
    {
        batch_ = tilingData->batch;
        rows_ = tilingData->rows;
        mDim_ = tilingData->mDim;
        nDim_ = tilingData->nDim;
        usedCoreNum_ = tilingData->usedCoreNum;
        singleM_ = tilingData->cubeTiling.singleCoreM;
        singleN_ = tilingData->cubeTiling.singleCoreN;
        bBits_ = tilingData->bBits;
        cBits_ = tilingData->cBits;
        panelM_ = tilingData->reserved >> 8U;
        if (panelM_ == 0U) {
            panelM_ = 1U;
        }
        CopyCube2PTransposeTiling(transposeTiling_,
            &tilingData->transposeTiling);

        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(a),
            static_cast<uint64_t>(batch_) * rows_ * rows_);
        pGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(p),
            static_cast<uint64_t>(batch_) * rows_ * rows_);
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreIdx = GetBlockIdx() / GetTaskRation();
        const uint32_t jobsPerBatch =
            Cube2PColumnJobsPerBatch(nDim_, panelM_);
        const uint32_t scheduledWork = batch_ * jobsPerBatch;
        if (coreIdx >= scheduledWork) {
            return;
        }

        CrossCoreSetFlag<kCube2PCvMode, PIPE_MTE3>(kCube2PAivFreeFlag);
        CrossCoreSetFlag<kCube2PCvMode, PIPE_MTE3>(kCube2PAivFreeFlag + 1);

        uint32_t sequence = 0;
        for (uint32_t jobIdx = coreIdx; jobIdx < scheduledWork;
             jobIdx += usedCoreNum_) {
            const uint32_t batchIdx = jobIdx / jobsPerBatch;
            const uint32_t localJob = jobIdx - batchIdx * jobsPerBatch;
            uint32_t tileN = 0;
            uint32_t mGroup = 0;
            Cube2PColumnGroupFromIndex(localJob, nDim_, panelM_, tileN,
                mGroup);
            for (uint32_t localM = 0; localM < panelM_; ++localM) {
                const uint32_t tileM = mGroup * panelM_ + localM;
                if (tileM > tileN) {
                    break;
                }
                ProcessScheduledTile(batchIdx, tileM, tileN, sequence++);
            }
        }
    }

private:
    __aicore__ inline void ProcessScheduledTile(uint32_t batchIdx,
        uint32_t tileM, uint32_t tileN, uint32_t sequence)
    {
        const uint32_t slot = sequence & 1U;
        const int16_t readyFlag = kCube2PAicReadyFlag +
            static_cast<int16_t>(slot);
        const int16_t freeFlag = kCube2PAivFreeFlag +
            static_cast<int16_t>(slot);
        CrossCoreWaitFlag<kCube2PCvMode, PIPE_V>(readyFlag);
        ProcessTile(batchIdx, tileM, tileN, slot);
        CrossCoreSetFlag<kCube2PCvMode, PIPE_MTE3>(freeFlag);
    }

    __aicore__ inline void ProcessTile(uint32_t batchIdx, uint32_t tileM,
        uint32_t tileN, uint32_t slot)
    {
        const uint32_t mBase = tileM * singleM_;
        const uint32_t nBase = tileN * singleN_;
        const uint32_t curM = Cube2PMin(singleM_, rows_ - mBase);
        const uint32_t curN = Cube2PMin(singleN_, rows_ - nBase);
        // 对非满尾块也采用 ceil/floor 切分，使两个 AIV 覆盖全部 curM 行。
        // 当前 host 要求 rows 128 对齐，保留该写法可明确边界语义。
        const uint32_t firstHalfM = (curM + 1U) / 2U;
        const uint32_t subBlock = GetSubBlockIdx();
        const uint32_t localM = subBlock == 0U ? firstHalfM : curM - firstHalfM;
        if (localM == 0U) {
            return;
        }

        const uint32_t rowBase = mBase + subBlock * firstHalfM;
        const uint32_t elements = localM * curN;
        // upperOffset 同时是 A 输入块和 P 上三角输出块的左上角。
        const uint64_t upperOffset = static_cast<uint64_t>(batchIdx) * rows_ * rows_ +
            static_cast<uint64_t>(rowBase) * rows_ + nBase;

        // a2Ub 由 AIC dual Fixpipe 预先写好；其余张量构成 A->FP32、
        // P(BF16) 与转置输出工作区。pInUb/pOutUb 指向同一物理地址，分别
        // 满足 Transpose 的 VECIN 与 Cast 的 VECOUT 位置要求。
        const uint32_t slotBase = slot == 0U ? 0U : kCube2PPongOffset;
        LocalTensor<float> a2Ub(TPosition::VECIN,
            slotBase + kCube2PA2Offset,
            kCube2PHalfElements);
        LocalTensor<bfloat16_t> aBf16Ub(TPosition::VECIN,
            slotBase + kCube2PABf16Offset, kCube2PHalfElements);
        LocalTensor<float> aFloatUb(TPosition::VECOUT,
            slotBase + kCube2PAFloatOffset, kCube2PHalfElements);
        LocalTensor<bfloat16_t> pInUb(TPosition::VECIN,
            slotBase + kCube2PPBf16Offset, kCube2PHalfElements);
        LocalTensor<bfloat16_t> pOutUb(TPosition::VECOUT,
            slotBase + kCube2PPBf16Offset, kCube2PHalfElements);
        LocalTensor<bfloat16_t> transOutUb(TPosition::VECOUT,
            slotBase + kCube2PTransposeOffset, kCube2PHalfElements);
        LocalTensor<uint8_t> transposeTmpUb(TPosition::VECIN,
            slotBase + kCube2PTmpInOffset, 8U * 1024U);

        // 从 GM 的二维矩阵中按行抽取 [localM,curN] 的 A upper 子块，
        // UB 目的各行连续。长度/stride 以 32-byte block 为单位。
        DataCopyParams copyA;
        copyA.blockCount = static_cast<uint16_t>(localM);
        copyA.blockLen = static_cast<uint16_t>(
            curN * sizeof(bfloat16_t) / ONE_BLK_SIZE);
        copyA.srcStride = static_cast<uint16_t>(
            (rows_ - curN) * sizeof(bfloat16_t) / ONE_BLK_SIZE);
        copyA.dstStride = 0;
        DataCopy(aBf16Ub, aGm_[upperOffset], copyA);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);

        // 通过 union 原样恢复 host 编码的 FP32 标量 b/c。
        union FloatBits {
            uint32_t bits;
            float value;
        } bScalar, cScalar;
        bScalar.bits = bBits_;
        cScalar.bits = cBits_;

        // 计算顺序保持 FP32：A(BF16)->FP32，分别缩放 A 与 A2，相加后
        // 以 round-to-nearest-even 转回 BF16，得到 P upper。
        Cast(aFloatUb, aBf16Ub, RoundMode::CAST_NONE,
            static_cast<int32_t>(elements));
        Muls(aFloatUb, aFloatUb, bScalar.value,
            static_cast<int32_t>(elements));
        Muls(a2Ub, a2Ub, cScalar.value, static_cast<int32_t>(elements));
        PipeBarrier<PIPE_V>();
        Add(aFloatUb, aFloatUb, a2Ub, static_cast<int32_t>(elements));
        PipeBarrier<PIPE_V>();
        Cast(pOutUb, aFloatUb, RoundMode::CAST_RINT,
            static_cast<int32_t>(elements));
        PipeBarrier<PIPE_V>();

        // upper 只依赖最终 Cast，先交给 MTE3。严格上三角 tile 随后在
        // Vector 上生成 lower，使 upper 写回与 ND2ND transpose 重叠。
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyParams copyUpper;
        copyUpper.blockCount = static_cast<uint16_t>(localM);
        copyUpper.blockLen = copyA.blockLen;
        copyUpper.srcStride = 0;
        copyUpper.dstStride = copyA.srcStride;
        DataCopy(pGm_[upperOffset], pOutUb, copyUpper);

        if (tileM < tileN) {
            // pInUb 与 pOutUb 是同一物理区域的输入/输出视图；这里 Vector
            // 与 MTE3 都只读取 P upper，允许两个流水并行消费。
            TransposeLower(pInUb, transOutUb, transposeTmpUb);
            SetFlag<HardEvent::V_MTE3>(1);
            WaitFlag<HardEvent::V_MTE3>(1);

            // [localM,curN] 转置为 [curN,localM]，写到
            // P[nBase:nBase+curN,rowBase:rowBase+localM]。
            const uint64_t lowerOffset = static_cast<uint64_t>(batchIdx) * rows_ * rows_ +
                static_cast<uint64_t>(nBase) * rows_ + rowBase;
            DataCopyParams copyLower;
            copyLower.blockCount = static_cast<uint16_t>(curN);
            copyLower.blockLen = static_cast<uint16_t>(
                localM * sizeof(bfloat16_t) / ONE_BLK_SIZE);
            copyLower.srcStride = 0;
            copyLower.dstStride = static_cast<uint16_t>(
                (rows_ - localM) * sizeof(bfloat16_t) / ONE_BLK_SIZE);
            DataCopy(pGm_[lowerOffset], transOutUb, copyLower);
        }

        // upper 与 lower 的异步 GM 写都必须结束，随后才能归还 UB 给 AIC。
        SetFlag<HardEvent::MTE3_S>(2);
        WaitFlag<HardEvent::MTE3_S>(2);
    }

    __aicore__ inline void TransposeLower(
        const LocalTensor<bfloat16_t> &src,
        const LocalTensor<bfloat16_t> &dst,
        const LocalTensor<uint8_t> &sharedTmp)
    {
        // BF16 按 16-bit 无符号元素转置可保持位模式不变；tiling 的输入
        // 形状为 [64,128]，输出即 [128,64]。
        Transpose(dst.template ReinterpretCast<uint16_t>(),
            src.template ReinterpretCast<uint16_t>(), sharedTmp,
            TransposeType::TRANSPOSE_ND2ND_ONLY, transposeTiling_);
        PipeBarrier<PIPE_V>();
    }

    GlobalTensor<bfloat16_t> aGm_; // 输入对称矩阵 A
    GlobalTensor<bfloat16_t> pGm_; // 最终对称矩阵 P
    uint32_t batch_;
    uint32_t rows_;
    uint32_t mDim_;
    uint32_t nDim_;
    uint32_t usedCoreNum_;
    uint32_t singleM_;
    uint32_t singleN_;
    uint32_t bBits_;               // FP32 b 的原始 bits
    uint32_t cBits_;               // FP32 c 的原始 bits
    uint32_t panelM_;
    ConfusionTransposeTiling transposeTiling_;
};

/*
 * mixed 设备入口：常驻低层 AIC 与两个 AIV 通过固定 UB 和 CrossCore flag 协作。
 */
extern "C" __global__ __aicore__ void MuonCube2PFused(GM_ADDR a, GM_ADDR p,
    GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    auto tilingData = reinterpret_cast<__gm__ MuonCube2PTilingData *>(tiling);

    if ASCEND_IS_AIC {
        MuonCube2PLowLevelAicKernel op;
        op.Init(a, p, tilingData);
        op.Process();
    }

    if ASCEND_IS_AIV {
        MuonCube2PAivKernel op;
        op.Init(a, p, tilingData);
        op.Process();
    }
}

extern "C" void launch_muon_cube2_p_fused(void *a, void *p, void *tiling,
    uint32_t blockDim, aclrtStream stream)
{
    MuonCube2PFused<<<blockDim, nullptr, stream>>>((GM_ADDR)a, (GM_ADDR)p,
        (GM_ADDR)tiling);
}


/* ============================== Cube3 + Y ============================== */
/*
 * Ascend 950（3510）Cube3 + AIV epilogue 融合 kernel。
 *
 * 数学表达式（每个 batch）：
 *   T = P @ X
 *   Y = alpha * X + T
 * 其中 P:[M,K]、X:[K,N]、T/Y:[M,N]，实际 Polar Express 中 K=M。
 *
 * 数据流：
 *   AIC: P/X(GM) -> Cube -> T(FP32, L0C)
 *        -> Fixpipe(NoQuant, dualDstCtl=SPLIT_M)
 *        -> AIV0/AIV1 各自的 ping/pong UB
 *   AIV: X(GM) -> UB -> aX + T -> Y(GM)
 *
 * 这个 kernel 必须以 KERNEL_TYPE_MIX_AIC_1_2 启动。AIC-only kernel 没有
 * AIV 子块的 UUB 上下文，直接使用 CO1->UB 会触发 507015/UUB illegal
 * instruction。
 *
 * AIC 使用低层 CMCT BlockMmad 常驻 block，并可选 B/X panel 全载复用；
 * 不生成 T(GM)，最终只写 BF16 Y。
 */

// Fixpipe 把 L0C 解释成 row-major ND，并写入 AIV 的 VECIN UB。
constexpr uint32_t kCube3TileM = 128;
constexpr uint32_t kCube3TileN = 128;
// SPLIT_M 后每个 AIV 接收 64x128 个 FP32。两个槽用于覆盖相邻 tile 的
// Cube/Fixpipe 与向量后处理。
constexpr uint32_t kCube3TSlotElements = kCube3TileM / 2U * kCube3TileN;
constexpr uint32_t kCube3TSlotBytes = kCube3TSlotElements * sizeof(float);
// 3510 官方 mixed MatMul 将双缓冲分别放在 UB 的两个半区。这样 Fixpipe
// 写 pong 时可与 AIV 读取 ping 并行，不在同一 UB 半区内争用。
constexpr uint32_t kCube3TPongOffset = 124U * 1024U;  // 3510: 248 KB UB 的一半
// X/Y stage 使用 BF16。容量等于一个 AIV 收到的最大半 tile；在边界形状
// 下 ProcessTile 仍支持按多 stage 分批处理。
constexpr uint32_t kCube3StageElements = kCube3TSlotElements;
constexpr uint32_t kCube3StageBytes = kCube3StageElements * sizeof(bfloat16_t);
constexpr uint32_t kCube3XUbOffset = kCube3TSlotBytes;
constexpr uint32_t kCube3YUbOffset = kCube3XUbOffset + kCube3StageBytes;
// 每个 T slot 绑定一套 X/Y stage，防止 MTE3 尚未结束时隔代覆盖 yUb。
constexpr uint32_t kCube3StageSlotBytes = 2U * kCube3StageBytes;

// ping/pong 握手编号。slot0/1 分别使用 free=5/6、ready=8/9；
// 第二个 AIV 的对应 flag 在此基础上加 16。
constexpr uint16_t kCube3CvMode = 4;
constexpr int16_t kCube3AivFreeFlag = 5;
constexpr int16_t kCube3AicReadyFlag = 8;
constexpr int16_t kCube3SecondAivFlagOffset = 16;

// host/device 共享 ABI。reserved 是位域而非真正未使用字段：
// bit1=B full-load，高 8 bit=panelM。
struct MuonCube3TilingData {
    uint32_t batch;          // batch 数
    uint32_t m;              // P/Y 的行数
    uint32_t n;              // X/Y 的列数
    uint32_t k;              // P 的列数 / X 的行数
    uint32_t mDim;           // M 方向 tile 数
    uint32_t nDim;           // N 方向 tile 数
    uint32_t usedCoreNum;    // 实际启动的逻辑 mixed block 数
    uint16_t alphaBits;      // BF16 alpha 的原始 16-bit 位模式
    uint16_t reserved;       // B full-load 位与 panelM
    TCubeTiling cubeTiling;  // tile 尺寸和 host tiling
};

// 设备侧 min，避免引入标准库。
__aicore__ inline uint32_t Cube3Min(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

/*
 * 官方 CMCT 低层 BlockMmad 路径。
 *
 * 该实现显式管理 L1、L0A/L0B 和两份 L0C，允许同一 AIC block连续处理
 * 多代 tile。L0C 的输出仍直接 dual
 * Fixpipe 到现有 AIV ping/pong UB，不产生 T(GM)。
 *
 * FullLoadMode 有两种实例：
 *   NONE_FULL_LOAD_MODE：每个 tile 正常搬入 P/X panel；
 *   B_FULL_LOAD_MODE：先把固定 tileN 的完整 X[:,tileN] 搬入 BL1，再连续
 *                     计算 panelM 个 tileM，复用这份 B panel。
 */
template <uint64_t FullLoadMode>
class MuonCube3LowLevelAicKernel {
public:
    // 模板给出最大 M/N/K 分块：L1 在 K=256 粒度搬运，L0 在 K=64
    // 粒度执行 Cube 累加；实际边界尺寸由 blockShape 传入。
    using L1TileShape = AscendC::Shape<Cmct::Gemm::_128, Cmct::Gemm::_256,
        Cmct::Gemm::_256>;
    using L0TileShape = AscendC::Shape<Cmct::Gemm::_128, Cmct::Gemm::_256,
        Cmct::Gemm::_64>;
    using DispatchPolicy = Cmct::Gemm::MatmulMultiBlockWithOutQue<
        AscendC::Shape<Cmct::Gemm::_0, Cmct::Gemm::_0, Cmct::Gemm::_0,
            Cmct::Gemm::_0>, FullLoadMode>;
    using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        bfloat16_t, false>;
    using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        bfloat16_t, false>;
    using CType = matmul::MatmulType<TPosition::VECIN, CubeFormat::ND,
        float, false>;
    using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND,
        float, false>;
    using BlockMmadOp = Cmct::Gemm::Block::BlockMmad<DispatchPolicy,
        L1TileShape, L0TileShape, AType, BType, CType, BiasType, void>;
    using TupleShape = AscendC::Shape<int64_t, int64_t, int64_t, int64_t>;
    using TupleL1L0Shape = AscendC::Shape<int64_t, int64_t, int64_t,
        int64_t, int64_t, int64_t>;

    // 初始化低层 BlockMmad 与 GM 视图。该路径不使用高阶 TCubeTiling
    // 的内部调度，只读取其中 host 已确定的 singleCoreM/N。
    __aicore__ inline void Init(GM_ADDR polynomial, GM_ADDR x, GM_ADDR y,
        const __gm__ MuonCube3TilingData *tilingData)
    {
        batch_ = tilingData->batch;
        m_ = tilingData->m;
        n_ = tilingData->n;
        k_ = tilingData->k;
        mDim_ = tilingData->mDim;
        nDim_ = tilingData->nDim;
        usedCoreNum_ = tilingData->usedCoreNum;
        singleM_ = tilingData->cubeTiling.singleCoreM;
        singleN_ = tilingData->cubeTiling.singleCoreN;
        // reserved 高 8 bit 保存 B full-load 时同一 BL1 panel 覆盖的 M tile 数。
        panelM_ = static_cast<uint32_t>(tilingData->reserved >> 8U);
        if (panelM_ == 0U) {
            panelM_ = 1U;
        }

        pGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(polynomial),
            static_cast<uint64_t>(batch_) * m_ * k_);
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x),
            static_cast<uint64_t>(batch_) * k_ * n_);
        // 无 bias，地址只用于满足 BlockMmad 的统一函数签名，不会被访问。
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), 1);

        // 低层 problem/tile shape 与高阶 tiling 保持相同逻辑矩阵尺寸。
        TupleShape problemShape{static_cast<int64_t>(m_), static_cast<int64_t>(n_),
            static_cast<int64_t>(k_), 1};
        TupleShape tileL1{static_cast<int64_t>(singleM_),
            static_cast<int64_t>(singleN_), 256, 1};
        TupleShape tileL0{static_cast<int64_t>(singleM_),
            static_cast<int64_t>(singleN_), 64, 1};
        AscendC::Shape<int64_t, int64_t, int64_t> nonContinuous{0, 1, 1};
        mm_.template Init<FullLoadMode>(problemShape,
            tileL1, tileL0, false, 2, true, nonContinuous);
        // copy-out 沿 M 将 L0C 分发到两个 AIV 的同偏移 UB。
        mm_.SetDualParam(true);
    }

    /*
     * 常驻 AIC 的两种调度：
     *
     * NONE：全局 workIdx 直接按 batch/tile 做 grid-stride；
     * B_FULL：全局 jobIdx 表示 (batch,tileN,mGroup)，一个 job 先加载一次
     *         B panel，再顺序产生不超过 panelM 个 tile。
     *
     * sequence 是该逻辑 block 实际产生的 tile 代数，AIV 必须按完全相同
     * 顺序递增，才能消费对应 ping/pong slot。
     */
    __aicore__ inline void Process()
    {
        const uint32_t coreIdx = GetBlockIdx();
        const uint32_t tilesPerBatch = mDim_ * nDim_;
        uint32_t sequence = 0;
        if constexpr (FullLoadMode == Cmct::Gemm::B_FULL_LOAD_MODE) {
            const uint32_t mGroupCount = (mDim_ + panelM_ - 1U) / panelM_;
            const uint32_t jobsPerBatch = nDim_ * mGroupCount;
            const uint32_t totalJobs = batch_ * jobsPerBatch;
            for (uint32_t jobIdx = coreIdx; jobIdx < totalJobs;
                 jobIdx += usedCoreNum_) {
                const uint32_t batchIdx = jobIdx / jobsPerBatch;
                const uint32_t localJob = jobIdx - batchIdx * jobsPerBatch;
                const uint32_t tileN = localJob / mGroupCount;
                const uint32_t mGroup = localJob - tileN * mGroupCount;
                // 同一 job 内的所有 tileM 共享这里加载的固定 tileN panel。
                PrepareBPanel(batchIdx, tileN, sequence != 0U);
                for (uint32_t localM = 0; localM < panelM_; ++localM) {
                    const uint32_t tileM = mGroup * panelM_ + localM;
                    if (tileM >= mDim_) {
                        break;
                    }
                    ProcessTile(batchIdx, tileM * nDim_ + tileN, sequence++);
                }
            }
        } else {
            const uint32_t totalWork = batch_ * tilesPerBatch;
            for (uint32_t workIdx = coreIdx; workIdx < totalWork;
                 workIdx += usedCoreNum_, ++sequence) {
                const uint32_t batchIdx = workIdx / tilesPerBatch;
                const uint32_t tileIdx = workIdx - batchIdx * tilesPerBatch;
                ProcessTile(batchIdx, tileIdx, sequence);
            }
        }

        // 空 block 没有与 AIV 建立 token 循环，不能等待不存在的 free。
        if (sequence == 0U) {
            return;
        }
        WaitForAiv();
    }

private:
    __aicore__ inline void PrepareBPanel(uint32_t batchIdx, uint32_t tileN,
        bool hasPreviousPanel)
    {
        if (hasPreviousPanel) {
            // B full-load 只保留一份 BL1。覆盖下一块 panel 前，先等待上一块
            // panel 的所有 L1->L0B 读取完成。
            SetFlag<HardEvent::MTE1_MTE2>(4);
            WaitFlag<HardEvent::MTE1_MTE2>(4);
        }
        // X 为 [K,N] row-major，从列 nBase 起抽取 [K,curN] 到 BL1。
        const uint32_t nBase = tileN * singleN_;
        const uint32_t curN = Cube3Min(singleN_, n_ - nBase);
        const uint64_t xOffset = static_cast<uint64_t>(batchIdx) * k_ * n_ + nBase;
        mm_.template CopyInB1<CubeFormat::ND>(xGm_[xOffset], curN, k_);
        // CopyInB1 走 MTE2；同步到 MTE1 后，后续 BL1->L0B 才能开始。
        SetFlag<HardEvent::MTE2_MTE1>(4);
        WaitFlag<HardEvent::MTE2_MTE1>(4);
    }

    __aicore__ inline void ProcessTile(uint32_t batchIdx, uint32_t tileIdx,
        uint32_t sequence)
    {
        // 一个常驻 block 的连续 tile 轮流使用 ping/pong；覆盖某槽前必须
        // 同时取得 AIV0/AIV1 的 free token。
        const uint32_t slot = sequence & 1U;
        const int16_t freeFlag = kCube3AivFreeFlag + static_cast<int16_t>(slot);
        const int16_t readyFlag = kCube3AicReadyFlag + static_cast<int16_t>(slot);
        CrossCoreWaitFlag<kCube3CvMode, PIPE_FIX>(freeFlag);
        CrossCoreWaitFlag<kCube3CvMode, PIPE_FIX>(
            freeFlag + kCube3SecondAivFlagOffset);

        const uint32_t tileM = tileIdx / nDim_;
        const uint32_t tileN = tileIdx - tileM * nDim_;
        const uint32_t mBase = tileM * singleM_;
        const uint32_t nBase = tileN * singleN_;
        const uint32_t curM = Cube3Min(singleM_, m_ - mBase);
        const uint32_t curN = Cube3Min(singleN_, n_ - nBase);

        // P tile 从 [mBase,0] 开始，X tile 从 [0,nBase] 开始。
        const uint64_t pOffset = static_cast<uint64_t>(batchIdx) * m_ * k_ +
            static_cast<uint64_t>(mBase) * k_;
        const uint64_t xOffset = static_cast<uint64_t>(batchIdx) * k_ * n_ + nBase;
        // 此 LocalTensor 是跨 AIC/AIV copy-out 的逻辑目的。每个 AIV 实际
        // 收到 curM 沿 M 切分后的一半，最大 64x128 FP32。
        const uint32_t tUbOffset = slot == 0U ? 0U : kCube3TPongOffset;
        LocalTensor<float> tUb(TPosition::VECIN, tUbOffset,
            kCube3TSlotElements);
        // 前四项是实际 M/N/K/batch，后两项保留原始 M/N stride 语义。
        TupleL1L0Shape blockShape{static_cast<int64_t>(curM),
            static_cast<int64_t>(curN), static_cast<int64_t>(k_), 1,
            static_cast<int64_t>(curM), static_cast<int64_t>(curN)};

        // 在 B_FULL_LOAD_MODE 下 BlockMmad 消费 PrepareBPanel 中预载的 BL1；
        // 普通模式则从传入的 xGm_ 视图完成常规 B 搬运。
        mm_.template operator()<LocalTensor<float>, CubeFormat::ND>(tUb,
            pGm_[pOffset], xGm_[xOffset], biasGm_, blockShape, 0, 0,
            false);

        // BlockMmad 的最终 copy-out 位于 PIPE_FIX；分别通知两个 AIV。
        CrossCoreSetFlag<kCube3CvMode, PIPE_FIX>(readyFlag);
        CrossCoreSetFlag<kCube3CvMode, PIPE_FIX>(
            readyFlag + kCube3SecondAivFlagOffset);
    }

    __aicore__ inline void WaitForAiv()
    {
        // 回收 ping/pong × AIV0/AIV1，确保末尾异步 Y 写回完成后再退出。
        CrossCoreWaitFlag<kCube3CvMode, PIPE_FIX>(kCube3AivFreeFlag);
        CrossCoreWaitFlag<kCube3CvMode, PIPE_FIX>(
            kCube3AivFreeFlag + kCube3SecondAivFlagOffset);
        CrossCoreWaitFlag<kCube3CvMode, PIPE_FIX>(kCube3AivFreeFlag + 1);
        CrossCoreWaitFlag<kCube3CvMode, PIPE_FIX>(
            kCube3AivFreeFlag + 1 + kCube3SecondAivFlagOffset);
    }

    BlockMmadOp mm_;                    // 常驻低层矩阵乘法对象
    GlobalTensor<bfloat16_t> pGm_;      // P:[batch,m,k]
    GlobalTensor<bfloat16_t> xGm_;      // X:[batch,k,n]
    GlobalTensor<float> biasGm_;        // 未启用 bias，仅作接口占位
    uint32_t batch_;
    uint32_t m_;
    uint32_t n_;
    uint32_t k_;
    uint32_t mDim_;
    uint32_t nDim_;
    uint32_t usedCoreNum_;
    uint32_t singleM_;
    uint32_t singleN_;
    uint32_t panelM_;                   // 每份 full-load B panel 的 M tile 复用数
};

class MuonCube3AivKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        const __gm__ MuonCube3TilingData *tilingData)
    {
        batch_ = tilingData->batch;
        m_ = tilingData->m;
        n_ = tilingData->n;
        mDim_ = tilingData->mDim;
        nDim_ = tilingData->nDim;
        usedCoreNum_ = tilingData->usedCoreNum;
        singleM_ = tilingData->cubeTiling.singleCoreM;
        singleN_ = tilingData->cubeTiling.singleCoreN;
        alphaBits_ = tilingData->alphaBits;
        bFullLoad_ = (tilingData->reserved & 2U) != 0U;
        panelM_ = static_cast<uint32_t>(tilingData->reserved >> 8U);
        if (panelM_ == 0U) {
            panelM_ = 1U;
        }

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x),
            static_cast<uint64_t>(batch_) * m_ * n_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y),
            static_cast<uint64_t>(batch_) * m_ * n_);
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreIdx = GetBlockIdx() / GetTaskRation();
        const uint32_t tilesPerBatch = mDim_ * nDim_;
        const uint32_t totalWork = batch_ * tilesPerBatch;
        uint32_t scheduledWork = totalWork;
        if (bFullLoad_) {
            const uint32_t mGroupCount = (mDim_ + panelM_ - 1U) / panelM_;
            scheduledWork = batch_ * nDim_ * mGroupCount;
        }
        if (coreIdx >= scheduledWork) {
            return;
        }

        CrossCoreSetFlag<kCube3CvMode, PIPE_MTE3>(kCube3AivFreeFlag);
        CrossCoreSetFlag<kCube3CvMode, PIPE_MTE3>(kCube3AivFreeFlag + 1);

        uint32_t sequence = 0;
        if (bFullLoad_) {
            const uint32_t mGroupCount = (mDim_ + panelM_ - 1U) / panelM_;
            const uint32_t jobsPerBatch = nDim_ * mGroupCount;
            const uint32_t totalJobs = batch_ * jobsPerBatch;
            for (uint32_t jobIdx = coreIdx; jobIdx < totalJobs;
                 jobIdx += usedCoreNum_) {
                const uint32_t batchIdx = jobIdx / jobsPerBatch;
                const uint32_t localJob = jobIdx - batchIdx * jobsPerBatch;
                const uint32_t tileN = localJob / mGroupCount;
                const uint32_t mGroup = localJob - tileN * mGroupCount;
                for (uint32_t localM = 0; localM < panelM_; ++localM) {
                    const uint32_t tileM = mGroup * panelM_ + localM;
                    if (tileM >= mDim_) {
                        break;
                    }
                    ProcessScheduledTile(batchIdx,
                        tileM * nDim_ + tileN, sequence++);
                }
            }
        } else {
            for (uint32_t workIdx = coreIdx; workIdx < totalWork;
                 workIdx += usedCoreNum_, ++sequence) {
                const uint32_t batchIdx = workIdx / tilesPerBatch;
                const uint32_t tileIdx = workIdx - batchIdx * tilesPerBatch;
                ProcessScheduledTile(batchIdx, tileIdx, sequence);
            }
        }
    }

private:
    __aicore__ inline void ProcessScheduledTile(uint32_t batchIdx,
        uint32_t tileIdx, uint32_t sequence)
    {
        const uint32_t slot = sequence & 1U;
        const int16_t readyFlag = kCube3AicReadyFlag + static_cast<int16_t>(slot);
        const int16_t freeFlag = kCube3AivFreeFlag + static_cast<int16_t>(slot);
        CrossCoreWaitFlag<kCube3CvMode, PIPE_V>(readyFlag);
        ProcessTile(batchIdx, tileIdx, slot);
        CrossCoreSetFlag<kCube3CvMode, PIPE_MTE3>(freeFlag);
    }

    __aicore__ inline void ProcessTile(uint32_t batchIdx, uint32_t tileIdx,
        uint32_t slot)
    {
        const uint32_t tileM = tileIdx / nDim_;
        const uint32_t tileN = tileIdx - tileM * nDim_;
        const uint32_t mBase = tileM * singleM_;
        const uint32_t nBase = tileN * singleN_;
        const uint32_t curM = Cube3Min(singleM_, m_ - mBase);
        const uint32_t curN = Cube3Min(singleN_, n_ - nBase);
        const uint32_t firstHalfM = (curM + 1U) / 2U;
        const uint32_t subBlock = GetSubBlockIdx();
        const uint32_t localM = subBlock == 0 ? firstHalfM : curM - firstHalfM;
        if (localM == 0) {
            return;
        }

        const uint32_t rowBase = mBase + subBlock * firstHalfM;
        const uint64_t gmOffset = static_cast<uint64_t>(batchIdx) * m_ * n_ +
            static_cast<uint64_t>(rowBase) * n_ + nBase;
        const uint32_t tUbOffset = slot == 0U ? 0U : kCube3TPongOffset;
        LocalTensor<float> tUb(TPosition::VECIN, tUbOffset,
            kCube3TSlotElements);
        // X/Y stage 也随 T 槽轮转，避免上一 tile 的 MTE3 尚未完成时
        // 下一 tile 覆盖同一份 yUb。
        const uint32_t stageSlotOffset = slot * kCube3StageSlotBytes;
        LocalTensor<bfloat16_t> xUb(TPosition::VECIN,
            kCube3XUbOffset + stageSlotOffset,
            kCube3StageElements);
        LocalTensor<bfloat16_t> yUb(TPosition::VECOUT,
            kCube3YUbOffset + stageSlotOffset,
            kCube3StageElements);

        union Bf16Bits {
            uint16_t bits;
            bfloat16_t value;
        } alpha;
        alpha.bits = alphaBits_;

        const uint32_t maxStageRows = kCube3StageElements / curN;
        uint32_t rowOffset = 0;
        while (rowOffset < localM) {
            const uint32_t stageRows = Cube3Min(maxStageRows, localM - rowOffset);
            const uint32_t stageElements = stageRows * curN;
            const uint64_t stageGmOffset = gmOffset + static_cast<uint64_t>(rowOffset) * n_;

            DataCopyParams copyInParams;
            copyInParams.blockCount = static_cast<uint16_t>(stageRows);
            copyInParams.blockLen = static_cast<uint16_t>(
                curN * sizeof(bfloat16_t) / ONE_BLK_SIZE);
            copyInParams.srcStride = static_cast<uint16_t>(
                (n_ - curN) * sizeof(bfloat16_t) / ONE_BLK_SIZE);
            copyInParams.dstStride = 0;
            DataCopy(xUb, xGm_[stageGmOffset], copyInParams);
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);

            Muls(xUb, xUb, alpha.value, static_cast<int32_t>(stageElements));
            Cast(yUb, tUb[rowOffset * curN], RoundMode::CAST_RINT,
                static_cast<int32_t>(stageElements));
            PipeBarrier<PIPE_V>();
            Add(yUb, yUb, xUb, static_cast<int32_t>(stageElements));
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);

            DataCopyParams copyOutParams;
            copyOutParams.blockCount = static_cast<uint16_t>(stageRows);
            copyOutParams.blockLen = copyInParams.blockLen;
            copyOutParams.srcStride = 0;
            copyOutParams.dstStride = copyInParams.srcStride;
            DataCopy(yGm_[stageGmOffset], yUb, copyOutParams);
            // CrossCore free 事件不能替代 AIV 本地的 MTE3 完成屏障。
            // 显式闭合写回后再进入下一 tile，避免同一 slot 隔代复用时
            // 上一轮的异步 GM 写回仍持有 UB 数据。
            SetFlag<HardEvent::MTE3_S>(2);
            WaitFlag<HardEvent::MTE3_S>(2);
            rowOffset += stageRows;
        }
    }

    GlobalTensor<bfloat16_t> xGm_;
    GlobalTensor<bfloat16_t> yGm_;
    uint32_t batch_;
    uint32_t m_;
    uint32_t n_;
    uint32_t mDim_;
    uint32_t nDim_;
    uint32_t usedCoreNum_;
    uint32_t singleM_;
    uint32_t singleN_;
    uint16_t alphaBits_;
    bool bFullLoad_;
    uint32_t panelM_;
};

extern "C" __global__ __aicore__ void MuonCube3FusedLowLevel(
    GM_ADDR polynomial, GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    auto tilingData = reinterpret_cast<__gm__ MuonCube3TilingData *>(tiling);

    if ASCEND_IS_AIC {
        if ((tilingData->reserved & 2U) != 0U) {
            MuonCube3LowLevelAicKernel<Cmct::Gemm::B_FULL_LOAD_MODE> op;
            op.Init(polynomial, x, y, tilingData);
            op.Process();
        } else {
            MuonCube3LowLevelAicKernel<Cmct::Gemm::NONE_FULL_LOAD_MODE> op;
            op.Init(polynomial, x, y, tilingData);
            op.Process();
        }
    }

    if ASCEND_IS_AIV {
        MuonCube3AivKernel op;
        op.Init(x, y, tilingData);
        op.Process();
    }
}

extern "C" void launch_muon_cube3_fused_lowlevel(void *polynomial, void *x,
    void *y, void *tiling, uint32_t blockDim, aclrtStream stream)
{
    MuonCube3FusedLowLevel<<<blockDim, nullptr, stream>>>((GM_ADDR)polynomial,
        (GM_ADDR)x, (GM_ADDR)y, (GM_ADDR)tiling);
}
